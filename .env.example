# Connection string PostgreSQL (Neon, Supabase, dll). Wajib pakai SSL untuk database di internet.
DATABASE_URL=postgres://user:030407@host/dbname?sslmode=require

# Kunci rahasia untuk menandatangani token login. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang
