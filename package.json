{
  "name": "arsiva",
  "private": true,
  "version": "1.0.0",
  "description": "Arsiva: sistem peminjaman inventaris dan aset sekolah (frontend + API dalam satu proyek, siap deploy ke Vercel).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite\" \"node --watch server/dev.js\"",
